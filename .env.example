# Vangrid MCP server

# Base URL of the x402 data API.
VANGRID_API_URL=https://data.vangrid.io

# Network to pay on: eip155:8453 Base, eip155:5042 Arc; testnets eip155:84532, eip155:5042002.
X402_NETWORK=eip155:8453

# Wallet that pays. Fund it with a few USDC on Base. Leave empty for the free tool only.
EVM_PRIVATE_KEY=

# Refuse any single request that costs more than this (USD).
MAX_USD_PER_CALL=0.05

# Refuse any single bounty payment above this (USD). Bounties are paid in full upfront.
MAX_USD_PER_BOUNTY=500

# Where bounty tokens are kept (default ~/.vangrid-mcp/bounties.json).
# VANGRID_MCP_STORE=
