# Vangrid MCP server

# Base URL of the x402 data API.
VANGRID_API_URL=https://data.vangrid.io

# Network to pay on. auto (default): wherever the wallet holds the most USDC, Base or Arc.
# Or fix it: eip155:8453 Base, eip155:5042 Arc mainnet, eip155:84532 Base Sepolia (testing).
# Fixing it also means only that network's balance is read, so fewer RPCs see the wallet.
X402_NETWORK=auto

# Wallet that pays. Fund it with a few USDC on Base or Arc. Leave empty for the free tool only.
EVM_PRIVATE_KEY=

# Refuse any single request that costs more than this (USD).
MAX_USD_PER_CALL=0.05

# Refuse any single bounty payment above this (USD). Bounties are paid in full upfront.
# This is also the most a prompt-injected accept can waste: vangrid_accept_submission is free
# and irreversible, so no spend cap applies to it. See SECURITY.md.
MAX_USD_PER_BOUNTY=100

# Where bounty tokens are kept (default ~/.vangrid-mcp/bounties.json).
# VANGRID_MCP_STORE=

# Deadline for one API call, including the x402 retry (ms, default 30000).
# VANGRID_HTTP_TIMEOUT_MS=30000

# Balance reads go to public RPCs, which therefore learn the wallet address. Point these at an
# RPC you control to avoid that.
# BASE_RPC_URL=
# ARC_RPC_URL=
# BASE_SEPOLIA_RPC_URL=
