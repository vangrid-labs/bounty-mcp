{
  "name": "@vangrid/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server that lets an agent query Vangrid's anchored capture data and pay per request with USDC on Base (x402).",
  "license": "MIT",
  "author": "VanGrid",
  "homepage": "https://github.com/vangrid-labs/bounty-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vangrid-labs/bounty-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vangrid-labs/bounty-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "usdc",
    "base",
    "arc",
    "vangrid",
    "agent",
    "payments"
  ],
  "bin": { "vangrid-mcp": "src/index.js" },
  "files": [
    "src",
    "scripts",
    ".env.example",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --check src/index.js && node --check src/client.js && node --check src/store.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/evm": "~2.27.0",
    "@x402/fetch": "~2.27.0",
    "dotenv": "^16.4.5",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  }
}
